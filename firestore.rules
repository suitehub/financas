rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // --- CLIENTES ---
    match /clientes/{clienteId} {
      allow read: if true;
      allow create: if isValidId(clienteId)
                    && request.resource.data.userId is string
                    && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 256;
      allow update: if isValidId(clienteId)
                    && request.resource.data.userId is string
                    && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 256;
      allow delete: if true;
    }

    // --- PROJETOS ---
    match /projetos/{projetoId} {
      allow read: if true;
      allow create: if isValidId(projetoId)
                    && request.resource.data.userId is string
                    && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 256;
      allow update: if isValidId(projetoId)
                    && request.resource.data.userId is string
                    && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 256;
      allow delete: if true;
    }

    // --- RECEBIMENTOS ---
    match /recebimentos/{recebimentoId} {
      allow read: if true;
      allow create: if isValidId(recebimentoId)
                    && request.resource.data.userId is string
                    && request.resource.data.valor is number && request.resource.data.valor >= 0;
      allow update: if isValidId(recebimentoId)
                    && request.resource.data.userId is string
                    && request.resource.data.valor is number && request.resource.data.valor >= 0;
      allow delete: if true;
    }

    // --- USUARIOS ---
    match /usuarios/{usuarioId} {
      allow read, write: if isValidId(usuarioId);
    }
  }
}

