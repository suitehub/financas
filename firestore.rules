rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Common Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // --- CLIENTES ---
    match /clientes/{clienteId} {
      allow read, write: if isValidId(clienteId);
    }

    // --- PROJETOS ---
    match /projetos/{projetoId} {
      allow read, write: if isValidId(projetoId);
    }

    // --- RECEBIMENTOS ---
    match /recebimentos/{recebimentoId} {
      allow read, write: if isValidId(recebimentoId);
    }

    // --- USUARIOS ---
    match /usuarios/{usuarioId} {
      allow read, write: if isValidId(usuarioId);
    }

    // Fallback block
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

